# MCP Server Configuration

# HTTP port for browser task submissions and dashboard
MCP_HTTP_PORT=3100

# Transport mode: "stdio" (default, for Cursor) or "sse" (for HTTP clients)
MCP_TRANSPORT=stdio

# Optional Bearer token for endpoint authentication (leave empty for no auth)
# MCP_AUTH_TOKEN=your-secret-token-here

# Development Notes:
# - Copy this file to .env and customize as needed
# - .env is gitignored and safe for secrets
# - Dashboard dev server runs on port 3101
# - Example app runs on port 5173 by default
