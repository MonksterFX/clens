{
  "name": "clens",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "example"
  ],
  "scripts": {
    "build": "npm run build -w @clens/lens && npm run build -w @clens/dashboard && npm run build -w @clens/mcp-server",
    "dev": "concurrently --kill-others -n dashboard,mcp -c blue,green \"npm run dev -w @clens/dashboard\" \"npm run dev -w @clens/mcp-server\"",
    "dev:full": "concurrently --kill-others -n lens,dashboard,mcp,example -c magenta,blue,green,yellow \"npm run dev -w @clens/lens\" \"npm run dev -w @clens/dashboard\" \"npm run dev -w @clens/mcp-server\" \"npm run dev -w example\"",
    "dev:example": "npm run dev -w example",
    "start": "npm run dev:full",
    "clean": "rm -rf packages/*/dist packages/*/node_modules example/dist node_modules",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"packages/**/*.{ts,tsx,js,jsx,json}\" \"example/src/**/*.{ts,tsx}\" \"*.{ts,js,json,md}\" \"tasks/**/*.md\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,js,jsx,json}\" \"example/src/**/*.{ts,tsx}\" \"*.{ts,js,json,md}\" \"tasks/**/*.md\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
